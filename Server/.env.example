NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (also used by the CSRF origin check)
CORS_ORIGINS=http://localhost:3000

# Parsed once at boot in src/config/env.ts
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gamyfied
REDIS_URL=redis://localhost:6379/0

# --- Auth (see Project/Auth.md) ---
# Signs access JWTs. Any long random string.
SESSION_SECRET=change-me
# Encrypts provider tokens at rest. 32 bytes hex:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Where the Next.js app lives; OAuth callbacks redirect here.
FRONTEND_URL=http://localhost:3000
# Public base URL of this API as the browser reaches it (through the Next.js /api rewrite in dev).
API_PUBLIC_URL=http://localhost:3000/api

# OAuth — leave a pair blank to disable that provider.
# GitHub: https://github.com/settings/developers  callback = $API_PUBLIC_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials  callback = $API_PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP delivery. "console" prints codes to the terminal; "live" sends them.
OTP_SENDER=live
# Email via any SMTP server (Nodemailer). Gmail: smtp://you@gmail.com:app-password@smtp.gmail.com:587
SMTP_URL=
MAIL_FROM=
# SMS via a self-hosted android-sms-gateway (https://github.com/capcom6/android-sms-gateway)
# e.g. http://192.168.1.20:8080/message with the app's basic-auth credentials.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# --- Profile verification (dev only) ---
# The agent does not exist yet; "Verify" requests stay queued. Set one of
# VERIFIED | PARTIALLY_VERIFIED | FAILED | INACCESSIBLE to have the placeholder provider
# answer immediately with that outcome so the UI states can be seen. Ignored in production.
VERIFICATION_MOCK_OUTCOME=
