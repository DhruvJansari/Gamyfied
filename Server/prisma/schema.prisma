// Prisma schema — the single source of truth for the Postgres structure.
// Every change here ships as a migration: `npm run db:migrate -- --name <what_changed>`.
// The connection URL lives in prisma.config.ts (read from DATABASE_URL), not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The compiled server runs as plain CommonJS (`node dist/server.js`, no bundler). tsx
  // masks an ESM/CJS mismatch here in local dev, but plain `node` in production can't
  // `require()` an ESM file — hence forcing this explicitly rather than relying on inference.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Models land here as each phase is built (see frontend/project/Context.md §7).
// Auth design: Project/Auth.md. Profile / placement / scoring: Context.md §5.4.

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Provider {
  GITHUB
  GOOGLE
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Permanent public ID, e.g. "7K2M9QX" (shown as #7K2M9QX). Never changes, never reused.
  publicId        String    @unique @map("public_id") @db.VarChar(7)
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at")
  phone           String?   @unique @db.VarChar(20)
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  displayName     String    @map("display_name") @db.VarChar(60)
  /// Changeable profile URL handle. Everything else resolves against publicId.
  handle          String    @unique @db.Citext
  role            Role      @default(USER)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  onboarding     Onboarding?
  profile        Profile?
  socialLinks    SocialLink[]
  projects       Project[]
  participations Participation[]
  verifications  Verification[]
  scoreComponents ScoreComponent[]
  score          Score?
  rankSnapshots  RankSnapshot[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          Provider
  providerAccountId String   @map("provider_account_id")
  /// Provider access token, AES-256-GCM encrypted. GitHub's is needed later for verification.
  accessTokenEnc    String?  @map("access_token_enc")
  scopes            String?
  /// Public identity at the provider (GitHub login). Seeds the LINKED social link.
  providerUsername  String?  @map("provider_username") @db.VarChar(100)
  avatarUrl         String?  @map("avatar_url") @db.VarChar(500)
  profileUrl        String?  @map("profile_url") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialLinks SocialLink[]

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// One row per login (device). `id` is the `sid` claim in the access JWT.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Hash of the token this one replaced — presenting it again means it was stolen.
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(32)
  ip                String?   @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousTokenHash])
  @@map("sessions")
}

enum OnboardingGoal {
  GET_HIRED
  BUILD_AUDIENCE
  COMPETE
}

/// Skill categories a user can be ranked in. Also the per-skill leaderboard keys later.
enum SkillCategory {
  WEB_DEV
  MOBILE_DEV
  AI_ML
  DSA_CP
  DEVOPS_CLOUD
  GAME_DEV
  CYBERSECURITY
  DATA_SCIENCE
}

/// One-time questionnaire result (Context.md §5.3). Re-submitting overwrites it — there is
/// no history here, just the current answer, which seeds category placement.
model Onboarding {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @unique @map("user_id") @db.Uuid
  /// Free-text stack tags as the user typed them, e.g. ["React", "Postgres"].
  stack       String[]
  goal        OnboardingGoal
  categories  SkillCategory[]
  completedAt DateTime        @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding")
}

// ---------------------------------------------------------------------------------------
// Profile phase (plan: profile / placement / scoring). The principle behind every table:
// the harder a fact is to fake, the more it is worth. Score is always recomputed from the
// current rows below — nothing here accrues points per action.
// ---------------------------------------------------------------------------------------

/// What the user says about themselves. One row per user, created with the user.
model Profile {
  userId            String   @id @map("user_id") @db.Uuid
  avatarUrl         String?  @map("avatar_url") @db.VarChar(500)
  headline          String?  @db.VarChar(120)
  bio               String?  @db.VarChar(2000)
  location          String?  @db.VarChar(80)
  websiteUrl        String?  @map("website_url") @db.VarChar(500)
  yearsOfExperience Int?     @map("years_of_experience")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Platforms a social link may point at. Adding one = new enum value + registry entry
/// in src/shared/social-platforms.ts. Arbitrary websites are deliberately not accepted.
enum SocialPlatform {
  GITHUB
  GITLAB
  LINKEDIN
  LEETCODE
  CODEFORCES
  STACKOVERFLOW
  HACKERRANK
  KAGGLE
  DEVTO
  HASHNODE
  MEDIUM
  X
}

/// How much we trust that a claim is really theirs.
/// CLAIMED = typed a URL. LINKED = signed in with that account. VERIFIED = agent checked it.
enum TrustLevel {
  CLAIMED
  LINKED
  VERIFIED
}

/// One per platform per user. LINKED rows are owned by the OAuth account, not the form.
model SocialLink {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   SocialPlatform
  /// Canonical form, e.g. https://github.com/octocat
  url        String         @db.VarChar(500)
  username   String         @db.VarChar(100)
  trustLevel TrustLevel     @default(CLAIMED) @map("trust_level")
  /// Set when LINKED: the OAuth account this link came from.
  accountId  String?        @map("account_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, platform])
  @@map("social_links")
}

/// PUBLIC = anyone (and the agent) can open it. PRIVATE = org / auth-walled; capped score.
enum ProjectType {
  PUBLIC
  PRIVATE
}

/// Where a claim stands with independent verification. Denormalised onto the subject row
/// for cheap display; the full history lives in `verifications`.
enum VerificationStatus {
  NOT_VERIFIED
  VERIFICATION_PENDING
  VERIFIED
  PARTIALLY_VERIFIED
  FAILED
  INACCESSIBLE
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  name               String             @db.VarChar(80)
  description        String             @db.VarChar(2000)
  technologies       String[]
  repoUrl            String?            @map("repo_url") @db.VarChar(500)
  liveUrl            String?            @map("live_url") @db.VarChar(500)
  projectType        ProjectType        @default(PUBLIC) @map("project_type")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

enum ParticipationKind {
  HACKATHON
  OPEN_SOURCE
  COMMUNITY
  EVENT
  FREELANCE
  COLLABORATION
  OTHER
}

/// Optional placement task: hackathons, open source, communities, freelance… Skipping it
/// costs nothing; a linked entry is worth a little, a verified one more.
model Participation {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  kind               ParticipationKind
  title              String             @db.VarChar(80)
  note               String?            @db.VarChar(500)
  /// Evidence link: Devpost page, merged PR, meetup page, client site…
  url                String?            @db.VarChar(500)
  year               Int?
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("participations")
}

enum VerificationSubject {
  PROJECT
  SOCIAL_LINK
  PARTICIPATION
}

/// MOCK = queued by this phase's placeholder provider. AGENT = the real thing, later.
enum VerificationSource {
  MOCK
  AGENT
}

/// One row per verification attempt on a project / link / participation. The agent (later)
/// fills `signals` (raw evidence), `result` (its evaluation) and `points` (what the scoring
/// engine awarded from them). Only the latest completed row per subject counts.
model Verification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  subjectType VerificationSubject @map("subject_type")
  subjectId   String              @map("subject_id") @db.Uuid
  status      VerificationStatus  @default(VERIFICATION_PENDING)
  source      VerificationSource
  requestedAt DateTime            @default(now()) @map("requested_at")
  completedAt DateTime?           @map("completed_at")
  /// After this, the result is stale and re-verification is due (scheduler: later phase).
  expiresAt   DateTime?           @map("expires_at")
  signals     Json?
  result      Json?
  points      Int?
  errorCode   String?             @map("error_code") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId, requestedAt])
  @@index([userId])
  @@map("verifications")
}

/// Where points come from. Adding a domain = a new value here + one writer that upserts its
/// ScoreComponent and calls scoringRepository.recomputeTotal. Nothing downstream changes.
enum ScoreDomain {
  PROFILE
  ACTIVITY
  POPULARITY
  CLAN
  EVENT
}

/// One row per (user, domain): the points that domain contributes and, optionally, the
/// explanation shown to the user. PROFILE is recomputed from current state on every profile
/// write. `total = base + Σ points` is kept on `scores`.
model ScoreComponent {
  userId       String      @map("user_id") @db.Uuid
  domain       ScoreDomain
  points       Int         @default(0)
  breakdown    Json?
  /// Which rules version produced this — lets a retune recompute everyone.
  rulesVersion Int         @map("rules_version")
  computedAt   DateTime    @default(now()) @map("computed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, domain])
  @@map("score_components")
}

/// Aggregate: total = base + Σ score_components.points. `isRanked` is the placement gate for
/// the leaderboard and is sticky once set. Score ≠ rank ≠ tier: rank is a Redis ZSET position,
/// tier is a function of rank; neither is stored here (history lives in rank_snapshots).
model Score {
  userId         String    @id @map("user_id") @db.Uuid
  base           Int       @default(1000)
  total          Int       @default(1000)
  /// When `total` last changed value (not when the row was last touched). The leaderboard
  /// tie-break: at equal totals, whoever reached that total first ranks higher.
  totalChangedAt DateTime  @default(now()) @map("total_changed_at")
  isRanked       Boolean   @default(false) @map("is_ranked")
  rankedAt       DateTime? @map("ranked_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isRanked, total])
  @@map("scores")
}

// ---------------------------------------------------------------------------------------
// Leaderboard. The live board is a Redis sorted set per board key, rebuilt from `scores`.
// Only history is stored here: it answers "why did my rank move", which current state cannot.
// ---------------------------------------------------------------------------------------

enum RankSnapshotReason {
  /// The user's own total changed.
  SCORE_CHANGE
  /// The user just became ranked.
  PLACED
  /// Scheduled sweep of a whole board (later phase).
  DAILY
}

/// A user's position on one board at one moment. Tier is stored as its label so history stays
/// readable after the bands change (tier_rules_version says which bands produced it).
model RankSnapshot {
  id               String             @id @default(uuid()) @db.Uuid
  boardKey         String             @map("board_key") @db.VarChar(64)
  userId           String             @map("user_id") @db.Uuid
  rank             Int
  tier             String             @db.VarChar(4)
  tierRulesVersion Int                @map("tier_rules_version")
  score            Int
  totalRanked      Int                @map("total_ranked")
  reason           RankSnapshotReason
  capturedAt       DateTime           @default(now()) @map("captured_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, boardKey, capturedAt(sort: Desc)])
  @@map("rank_snapshots")
}
